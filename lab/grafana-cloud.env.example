# Copy this to grafana-cloud.env (already gitignored via lab/*.env) and fill
# in real values from Grafana Cloud: Connections > Add new connection >
# OpenTelemetry (OTLP).
#
# These are the exact keys the `grafana-cloud-creds` Secret in namespace
# otel-lab was created from:
#   kubectl create secret generic grafana-cloud-creds -n otel-lab \
#     --from-env-file=grafana-cloud.env

GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
